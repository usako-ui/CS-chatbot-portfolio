# ============================================================
# BOTANICA CSチャットボット MVP｜環境変数テンプレート
# ------------------------------------------------------------
# 使い方：
#   1. このファイルを .env.local としてコピーする
#        cp .env.example .env.local
#   2. 各値を Supabase / Google AI Studio から取得して埋める
#   3. .env.local は .gitignore 済み。絶対にコミットしないこと
# ------------------------------------------------------------
# 環境変数を追加したら、このファイルも必ず同期更新すること
# ============================================================


# ------------------------------------------------------------
# Supabase（ブラウザから参照可）
#   NEXT_PUBLIC_ 接頭辞が付いた値はクライアントJSにバンドルされ、
#   誰でも閲覧できる。公開して問題ない値のみ設定すること。
#   取得場所：Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------

# プロジェクトのURL
NEXT_PUBLIC_SUPABASE_URL=

# anon key（公開OK）
#   用途① 顧客側：匿名サインイン + Realtime購読（読み取り）
#   用途② 管理画面：オペレーターのメール・パスワード認証
#   このキー単体では RLS を突破できないため公開しても安全
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ------------------------------------------------------------
# Supabase（サーバー専用・絶対に NEXT_PUBLIC_ を付けない）
# ------------------------------------------------------------

# サーバー側から参照するURL（NEXT_PUBLIC_SUPABASE_URL と同じ値でよい）
SUPABASE_URL=

# service_role key（最重要機密）
#   RLS を完全にバイパスして全データへアクセスできる。
#   漏洩すると全顧客の会話・個人情報が第三者に読み書きされる。
#   Server Action の中でのみ使用すること。
#   NEXT_PUBLIC_ を付けた瞬間にクライアントへ露出するため厳禁。
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------
# Gemini API（サーバー専用・絶対に NEXT_PUBLIC_ を付けない）
#   取得場所：https://aistudio.google.com/apikey
#   漏洩すると第三者に API を使われ、無料枠を食い潰される。
#   Server Action（/actions/ai.ts）経由でのみ使用すること。
# ------------------------------------------------------------
GEMINI_API_KEY=


# ------------------------------------------------------------
# 本番チャットの受付終了フラグ（任意・既定は未設定）
#   1 を設定すると、本番チャットのページがチャットを起動せず
#   「このデモは終了しました」の案内だけを表示する。
#   講座提出後に GEMINI_API_KEY を外す運用と合わせて使う。
#   キーが無いままチャットを開かせると
#   「担当者に接続しています。」しか返らず、
#   誰も見ていない管理画面に会話だけが溜まるため。
#   外して再デプロイすれば元に戻る。
# ------------------------------------------------------------
LIVE_CHAT_CLOSED=


# ============================================================
# 営業時間・定休曜日・休日・当日フラグは環境変数では管理しない。
# Supabase の business_settings テーブルで管理する。
# 理由：オペレーターが管理画面から即時変更する必要があり（AC-015〜017）、
#       環境変数だと変更のたびに再デプロイが必要になるため。
# ============================================================
