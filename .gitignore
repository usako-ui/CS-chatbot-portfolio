# ============================================
# 環境変数（絶対にコミットしない）
# ============================================
.env
.env.*
!.env.example

# ============================================
# 内部作業資料（公開リポジトリには含めない）
#   このリポジトリは講座提出・ポートフォリオとして公開する。
#   開発プロセス用の資料はローカルにのみ置く。
#   ※ファイルは削除せず、Gitの追跡対象から外すだけ
# ============================================
CLAUDE.md
tasks.md
progress.md
_verify.local/
_operator-credentials.local.md
agent-brief.md
botanica_design_v3.html

# 講座提供のナレッジ原本（CSV）。
#   FAQ本文は supabase/seed.sql に取り込み済みのため、原本は公開しない。
#   ファイルはローカルに残るので、差し替え時はそのまま参照してよい。
docs/knowledge/

# ============================================
# Git worktree の展開先
#   .worktrees/ 配下は各featureブランチの作業ディレクトリ。
#   実体はGitが管理しているため、リポジトリには含めない。
# ============================================
.worktrees/

# ============================================
# 依存パッケージ
# ============================================
node_modules/
.pnp
.pnp.js

# ============================================
# Next.js ビルド成果物
# ============================================
.next/
out/
build/
dist/
next-env.d.ts

# ============================================
# Vercel
# ============================================
.vercel

# ============================================
# Supabase（ローカル開発時の一時ファイル）
# ============================================
.branches
.temp
supabase/.temp/

# ============================================
# ログ・デバッグ
# ============================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================
# テスト・カバレッジ
# ============================================
coverage/
.nyc_output/

# ============================================
# TypeScript
# ============================================
*.tsbuildinfo

# ============================================
# OS・エディタ
# ============================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
